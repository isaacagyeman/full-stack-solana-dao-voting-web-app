    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "cross-env":"^10.1.0",
    "dotenv-cli":"^11.0.0",
    "env-cmd":"^11.0.0",
