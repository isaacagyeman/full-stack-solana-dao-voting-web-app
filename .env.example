# Copy this file to .env and fill in your values.
# The API server reads these at startup.

# PostgreSQL connection string
# Local example: postgresql://postgres:password@localhost:5432/votechain
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/votechain

# Secret used to sign JWT tokens — any long random string works for local dev
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string
